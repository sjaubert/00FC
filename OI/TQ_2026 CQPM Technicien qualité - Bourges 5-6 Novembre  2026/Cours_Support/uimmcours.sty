% ============================================================
%  uimmcours.sty  -  Style commun des cours support Capabilite & SPC
%  Pole Formation UIMM CVDL - S. Jaubert
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{uimmcours}[2026/07/21 Style cours UIMM CVDL]

\RequirePackage{fontspec}
\setmainfont{Latin Modern Roman}
\setsansfont{Latin Modern Sans}
\RequirePackage[french]{babel}
\RequirePackage{amsmath,amssymb}
\RequirePackage{geometry}
\RequirePackage[table]{xcolor}
\RequirePackage{titlesec}
\RequirePackage[most]{tcolorbox}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.16}
\RequirePackage{fancyhdr}
\RequirePackage[hidelinks]{hyperref}

\geometry{a4paper,top=2cm,bottom=2.2cm,left=2.3cm,right=2.3cm}

% ---- Couleurs UIMM ----
\definecolor{uimmblue}{HTML}{1B3A6B}
\definecolor{uimmcyan}{HTML}{09B2DD}
\definecolor{uimmorange}{HTML}{E87722}
\definecolor{uimmpurple}{HTML}{6D28D9}
\definecolor{uimmgrey}{HTML}{4B5563}
\definecolor{lightgrey}{HTML}{F1F2F1}
\definecolor{tablehead}{HTML}{1B3A6B}
\definecolor{tablealt}{HTML}{F7F9FC}

\hypersetup{colorlinks=true,linkcolor=uimmblue,urlcolor=uimmcyan,pdfborder={0 0 0}}

% ---- Titres de section ----
\titleformat{\section}
  {\color{uimmblue}\large\bfseries\sffamily}
  {\color{uimmcyan}\thesection.}{0.5em}{}
  [{\vspace{-4pt}\color{uimmcyan}\titlerule[1.4pt]}]
\titlespacing*{\section}{0pt}{16pt}{8pt}

\titleformat{\subsection}
  {\color{uimmcyan}\bfseries\sffamily}{}{0em}{}
\titlespacing*{\subsection}{0pt}{10pt}{3pt}

\setlist[itemize]{leftmargin=1.4em,itemsep=2pt,topsep=3pt}
\setlist[enumerate]{leftmargin=1.6em,itemsep=2pt,topsep=3pt}

% ---- En-tete / pied de page ----
\newcommand{\coursnumero}{}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\color{uimmgrey}UIMM CVDL – S. Jaubert}
\fancyfoot[C]{\footnotesize\color{uimmgrey}Cours support Capabilité \& SPC}
\fancyfoot[R]{\footnotesize\color{uimmgrey}\coursnumero}

% ---- Bandeau de titre ----
% \coursheader{surtitre}{titre}{sous-titre/meta}{tagline}
\newcommand{\coursheader}[4]{%
\begin{tcolorbox}[enhanced,colback=uimmblue,colframe=uimmblue,boxrule=0pt,
  arc=3pt,left=16pt,right=16pt,top=12pt,bottom=12pt,before skip=0pt,after skip=6pt]
  {\sffamily\bfseries\footnotesize\color{uimmcyan}\MakeUppercase{#1}}\\[3pt]
  {\sffamily\bfseries\LARGE\color{white}#2}\\[5pt]
  {\sffamily\small\color{white!75}#3}
\end{tcolorbox}%
\begin{tcolorbox}[colback=uimmcyan,colframe=uimmcyan,boxrule=0pt,arc=1pt,
  left=16pt,right=16pt,top=5pt,bottom=5pt,before skip=0pt,after skip=14pt]
  {\sffamily\bfseries\footnotesize\color{white}\MakeUppercase{#4}}
\end{tcolorbox}%
}

% ---- Encadre d'accroche (lead) ----
\newtcolorbox{lead}{enhanced,breakable,colback=white,colframe=uimmcyan,
  boxrule=0pt,leftrule=4pt,arc=1pt,left=12pt,right=12pt,top=8pt,bottom=8pt}

% ---- Encadre "A retenir" / cle ----
\newtcolorbox{cle}[1][À retenir]{enhanced,breakable,colback=uimmorange!7,
  colframe=uimmorange,boxrule=0pt,leftrule=4pt,arc=1pt,
  left=12pt,right=12pt,top=8pt,bottom=8pt,
  title={\sffamily\bfseries\footnotesize\MakeUppercase{#1}},coltitle=uimmorange,
  fonttitle=\bfseries,attach title to upper=\par\medskip}

% ---- Encadre exemple ----
\newtcolorbox{exemple}[1][Exemple chiffré]{enhanced,breakable,colback=uimmcyan!6,
  colframe=uimmcyan!55,boxrule=0.6pt,arc=2pt,left=12pt,right=12pt,top=8pt,bottom=8pt,
  title={\sffamily\bfseries\footnotesize\color{uimmblue}\MakeUppercase{#1}},
  attach title to upper=\par\smallskip}

% ---- Encadre "Pour aller plus loin" ----
\newtcolorbox{plusloin}{enhanced,breakable,colback=uimmpurple!5,
  colframe=uimmpurple!45,boxrule=0.6pt,arc=2pt,left=12pt,right=12pt,top=8pt,bottom=8pt,
  title={\sffamily\bfseries\footnotesize\color{uimmpurple}POUR ALLER PLUS LOIN},
  attach title to upper=\par\smallskip}

% ---- Renvoi vers un TP ----
% \renvoitp{tag}{titre}{description}{href}
\newcommand{\renvoitp}[4]{%
\begin{tcolorbox}[enhanced,breakable,colback=uimmblue,colframe=uimmblue,boxrule=0pt,
  arc=3pt,left=12pt,right=12pt,top=9pt,bottom=9pt,before skip=10pt,after skip=10pt]
  {\sffamily\bfseries\footnotesize\colorbox{uimmcyan}{\color{white}\,\MakeUppercase{#1}\,}}\hfill
  {\sffamily\bfseries\color{uimmcyan}\large$\rightarrow$}\\[5pt]
  {\sffamily\bfseries\large\color{white}\href{#4}{#2}}\\[3pt]
  {\sffamily\small\color{white!80}#3}
\end{tcolorbox}%
}

% ---- Tableaux ----
\newcommand{\thline}{\arrayrulecolor{uimmblue!30}\hline\arrayrulecolor{black}}
\newenvironment{uimmtable}[1]
  {\renewcommand{\arraystretch}{1.25}\rowcolors{2}{tablealt}{white}%
   \begin{center}\begin{tabular}{#1}}
  {\end{tabular}\end{center}}
\newcommand{\thead}[1]{\rowcolor{tablehead}\color{white}\bfseries #1}

% ---- Formule mise en avant ----
\newtcolorbox{formulebox}{colback=lightgrey,colframe=black!15,boxrule=0.6pt,
  arc=2pt,left=10pt,right=10pt,top=6pt,bottom=6pt,halign=center,
  before skip=8pt,after skip=8pt}

\endinput
